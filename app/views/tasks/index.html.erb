<p style="color: green"><%= notice %></p>

<h1>Minhas Tarefas da Semana</h1>

<div style="display: flex; gap: 10px; overflow-x: auto;">
  <% @tarefas_por_dia.each do |dia, tarefas| %>
    <div style="min-width: 150px; flex: 1; border: 1px solid #ccc; padding: 10px; border-radius: 5px;">
      <h3 style="text-align: center; border-bottom: 2px solid #333; padding-bottom: 5px;"><%= dia %></h3>

      <% if tarefas.any? %>
        <% tarefas.each do |task| %>
          <div style="margin-bottom: 10px; padding: 5px; background-color: #f5f5f5; border-radius: 3px;">
            <strong><%= task.title %></strong>
            <p style="font-size: 12px; color: #555;"><%= task.description %></p>
            <%= link_to "Ver detalhes", task, style: "font-size: 12px;" %>
          </div>
        <% end %>
      <% else %>
        <p style="color: gray; font-size: 12px; text-align: center;"><em>Sem tarefas</em></p>
      <% end %>
    </div>
  <% end %>
</div>

<br>
<%= link_to "Nova Tarefa", new_task_path %>
