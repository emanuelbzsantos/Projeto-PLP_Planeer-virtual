<%= form_with(model: task) do |form| %>
  <% if task.errors.any? %>
    <div style="color: red">
      <h2><%= task.errors.count %> erro(s) impediram que a tarefa fosse salva:</h2>

      <ul>
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, "Descrição", style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :due_date, "Data de entrega", style: "display: block" %>
    <%= form.datetime_field :due_date %>
  </div>

  <div>
    <%= form.submit "Salvar Tarefa" %>
  </div>
<% end %>
