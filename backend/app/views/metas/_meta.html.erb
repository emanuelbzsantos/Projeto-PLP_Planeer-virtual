<% 
  # Define a cor de acordo com o status
  cor = case meta.status
        when "cumprida" then "#2e7d32"
        when "parcialmente_cumprida" then "#f9a825"
        when "nao_cumprida" then "#c62828"
        else "#555"
        end
%>

<div id="meta_<%= meta.id %>" style="margin-bottom: 10px; padding: 8px; background-color: #f5f5f5; border-left: 4px solid <%= cor %>; border-radius: 3px;">
  <div>
    <strong><%= meta.descricao %></strong>
  </div>

  <div style="font-size: 12px; color: #555;">
    Categoria: <%= meta.categoria %>
  </div>

  <div style="font-size: 12px; color: <%= cor %>; font-weight: bold;">
    <%= meta.status_formatado %>
  </div>
</div>
